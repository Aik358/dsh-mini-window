{
  "name": "@a9i5k4/dsh-mini-window",
  "version": "0.1.0",
  "private": false,
  "description": "DSH mini window: a compact single-column conversation view triggered by ?dsh-mini=1, plus an optional standalone mini-window process (floating ball + frameless window).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./mini-spec": "./lib/mini-spec.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mini-window",
    "compact",
    "client-plugin"
  ],
  "author": "Aik358",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aik358/dsh-mini-window.git"
  },
  "homepage": "https://github.com/Aik358/dsh-mini-window#readme",
  "bugs": {
    "url": "https://github.com/Aik358/dsh-mini-window/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
